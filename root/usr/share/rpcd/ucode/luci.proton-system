'use strict';

import { readfile, lsdir, popen } from 'fs';
import { cursor } from 'uci';

// --- Package / release helpers (existing) ----------------------------------

function readFileContent(path) {
	let content = readfile(path);
	return content ? trim(content) : null;
}

function parseReleaseValue(content, key) {
	if (!content || !key) return null;

	let pattern = key + "='";
	let start = index(content, pattern);
	if (start < 0) return null;

	let valueStart = start + length(pattern);
	let tail = substr(content, valueStart);
	let valueEnd = index(tail, "'");
	if (valueEnd < 0) return null;

	return substr(tail, 0, valueEnd);
}

function extractUrl(line) {
	if (!line) return null;

	let httpsStart = index(line, 'https://');
	let httpStart = index(line, 'http://');
	let start = httpsStart;

	if (start < 0 || (httpStart >= 0 && httpStart < start))
		start = httpStart;

	if (start < 0) return null;

	let tail = substr(line, start);
	let end = length(tail);

	for (let i = 0; i < length(tail); i++) {
		let ch = substr(tail, i, 1);
		if (ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' || ch == '"' || ch == '\'' || ch == '#') {
			end = i;
			break;
		}
	}

	return substr(tail, 0, end);
}

function isCommentOrEmptyLine(line) {
	let normalized = trim(line || '');
	if (!normalized) return true;

	return index(normalized, '#') == 0;
}

function normalizePackageFeedUrl(url, packageArch) {
	if (!url || !packageArch) return null;

	let marker = '/packages/' + packageArch;
	let markerPos = index(url, marker);
	if (markerPos < 0) return null;

	return substr(url, 0, markerPos + length(marker)) + '/';
}

function findPackageFeedUrlInContent(content, packageArch) {
	if (!content || !packageArch) return null;

	for (let line in split(content, "\n")) {
		if (isCommentOrEmptyLine(line))
			continue;

		let url = extractUrl(line);
		let normalized = normalizePackageFeedUrl(url, packageArch);
		if (normalized) return normalized;
	}

	return null;
}

function buildFallbackPackageFeedUrl(packageArch, releaseVersion) {
	let normalizedRelease = trim(releaseVersion || '');
	if (!normalizedRelease || !packageArch) return null;

	if (normalizedRelease == 'SNAPSHOT' || normalizedRelease == 'snapshot')
		return 'https://downloads.openwrt.org/snapshots/packages/' + packageArch + '/';

	let firstChar = substr(normalizedRelease, 0, 1);
	if (index('0123456789', firstChar) == 0 || index('0123456789', firstChar) > 0)
		return 'https://downloads.openwrt.org/releases/' + normalizedRelease + '/packages/' + packageArch + '/';

	return null;
}

function findPackageFeedUrl(packageArch, releaseVersion) {
	let directFiles = [
		'/etc/opkg/distfeeds.conf',
		'/etc/opkg/customfeeds.conf',
		'/etc/apk/repositories',
		'/etc/apk/distfeeds.list',
		'/etc/apk/repositories.d/distfeeds.list'
	];

	for (let path in directFiles) {
		let content = readFileContent(path);
		let url = findPackageFeedUrlInContent(content, packageArch);
		if (url) return url;
	}

	let repoFiles = lsdir('/etc/apk/repositories.d');
	if (repoFiles) {
		for (let name in repoFiles) {
			let content = readFileContent('/etc/apk/repositories.d/' + name);
			let url = findPackageFeedUrlInContent(content, packageArch);
			if (url) return url;
		}
	}

	return buildFallbackPackageFeedUrl(packageArch, releaseVersion);
}

function getReleaseDescription(release) {
	return parseReleaseValue(release, 'DISTRIB_DESCRIPTION');
}

function getReleaseVersion(release) {
	return parseReleaseValue(release, 'DISTRIB_RELEASE');
}

function getModelFromSysinfo() {
	return readFileContent('/tmp/sysinfo/model');
}

function getTimezoneInfo() {
	let uci = cursor();
	uci.load('system');

	if (!uci.get('system', '@system[0]'))
		return { timezone: '', zonename: '' };

	return {
		timezone: uci.get('system', '@system[0]', 'timezone') ?? '',
		zonename: uci.get('system', '@system[0]', 'zonename') ?? ''
	};
}

function countCpuCores() {
	let stat = readfile('/proc/stat');
	if (!stat) return 0;

	let cores = 0;
	for (let line in split(stat, '\n')) {
		if (match(line, /^cpu[0-9]+[ \t]/))
			cores++;
	}
	return cores;
}

function getSystemInfo() {
	let release = readFileContent('/etc/openwrt_release') || '';
	let packageArch = parseReleaseValue(release, 'DISTRIB_ARCH');
	let releaseVersion = getReleaseVersion(release);
	let tz = getTimezoneInfo();

	return {
		package_arch: packageArch,
		target: parseReleaseValue(release, 'DISTRIB_TARGET'),
		release: releaseVersion,
		description: getReleaseDescription(release),
		model: getModelFromSysinfo(),
		package_feed_url: findPackageFeedUrl(packageArch, releaseVersion),
		timezone: tz.timezone,
		zonename: tz.zonename,
		cores: countCpuCores()
	};
}

// --- CPU load (existing) ---------------------------------------------------

let prevCpuSnapshot = null;

function readCpuSnapshot() {
	let stat = readfile('/proc/stat');
	if (!stat) return null;

	let firstLine = null;
	for (let line in split(stat, '\n')) {
		if (index(line, 'cpu ') == 0) {
			firstLine = line;
			break;
		}
	}
	if (!firstLine) return null;

	let parts = split(trim(firstLine), /[ \t]+/);
	let values = [];
	let total = 0;

	for (let i = 1; i < length(parts); i++) {
		let v = +parts[i];
		if (v != v) continue;
		push(values, v);
		total += v;
	}

	if (length(values) < 4) return null;

	let idle = (values[3] ?? 0) + (values[4] ?? 0);

	return { total: total, idle: idle };
}

// --- Process count (running / total) ---------------------------------------
//
// Берём 4-е поле /proc/loadavg: "X.XX X.XX X.XX running/total last_pid".
// running — процессов в состоянии R, total — общее число процессов
// (включая потоки ядра, что нормально для busybox/OpenWrt).

function readProcessCount() {
	let content = readFileContent('/proc/loadavg');
	if (!content) return null;

	let parts = split(content, ' ');
	if (length(parts) < 4) return null;

	let pair = parts[3];
	if (!pair) return null;

	let slash = index(pair, '/');
	if (slash < 0) return null;

	let running = +(substr(pair, 0, slash) ?? 0);
	let total = +(substr(pair, slash + 1) ?? 0);

	if (running != running || total != total) return null;

	return { running: running, total: total };
}

function getProcessCount() {
	let counts = readProcessCount();

	if (!counts) {
		return { running: null, total: null };
	}

	return {
		running: counts.running,
		total: counts.total,
		timestamp: time()
	};
}

// --- Top processes by CPU / memory -----------------------------------------
//
// Ограничение на количество процессов, чтобы не улететь по времени на
// роутерах с сотнями потоков. 150 — разумный компромисс (обычно в системе
// 60-120 процессов).
const MAX_PROC_SCAN = 150;

// Читаем /proc/<pid>/stat: поле 14 (utime) + 15 (stime) = тики CPU.
// Поле 22 (starttime) не нужно, берём только CPU.
function readProcCpu(pid) {
	let content = readFileContent('/proc/' + pid + '/stat');
	if (!content) return null;

	let lastParen = rindex(content, ')');
	if (lastParen < 0) return null;

	let tail = substr(content, lastParen + 2);
	let fields = split(tail, ' ');

	// После comm: state(0) ppid(1) ... utime(11) stime(12)
	if (length(fields) < 13) return null;

	let utime = +(fields[11] ?? 0);
	let stime = +(fields[12] ?? 0);

	if (utime != utime || stime != stime) return null;

	return utime + stime;
}

// Читаем /proc/<pid>/statm: 2-е поле = RSS в страницах.
function readProcRss(pid) {
	let content = readFileContent('/proc/' + pid + '/statm');
	if (!content) return null;

	let parts = split(trim(content), ' ');
	if (length(parts) < 2) return null;

	let pages = +(parts[1] ?? 0);
	if (pages != pages) return null;

	// Обычно 4096 байт на страницу; в OpenWrt на MIPS может быть 4 KiB тоже.
	return pages * 4096;
}

// Имя процесса — из /proc/<pid>/comm (обрезано до 15 символов),
// или из cmdline как fallback.
function readProcName(pid) {
	let comm = readFileContent('/proc/' + pid + '/comm');
	if (comm) {
		let trimmed = trim(comm);
		if (length(trimmed) > 0) return trimmed;
	}

	// Fallback: первый токен cmdline
	let cmdline = readFileContent('/proc/' + pid + '/cmdline');
	if (!cmdline) return '?';

	// cmdline разделён нулями
	let parts = split(cmdline, "\x00");
	if (length(parts) > 0 && length(trim(parts[0])) > 0)
		return trim(parts[0]);

	return '?';
}

// Возвращает топ-N процессов по CPU (ticks) или по RSS.
// kind: 'cpu' | 'ram'
function getTopProcesses(kind, limit) {
	if (kind != 'cpu' && kind != 'ram') kind = 'cpu';
	if (limit == null || limit < 1 || limit > 20) limit = 3;

	let entries = lsdir('/proc');
	if (!entries) return { processes: [] };

	let procs = [];
	let scanned = 0;

	for (let name in entries) {
		if (scanned >= MAX_PROC_SCAN) break;

		// Только числовые директории (PID)
		if (match(name, /^[0-9]+$/) == null) continue;
		scanned++;

		let pid = +name;
		let pname = readProcName(pid);
		if (!pname) continue;

		let value = 0;
		let metric_name = '';

		if (kind == 'cpu') {
			value = readProcCpu(pid) ?? 0;
			metric_name = 'cpu_ticks';
		} else {
			value = readProcRss(pid) ?? 0;
			metric_name = 'rss_bytes';
		}

		push(procs, {
			pid: pid,
			name: pname,
			value: value
		});
	}

	// Сортировка по убыванию
	procs = sort(procs, function(a, b) { return b.value - a.value; });
	if (length(procs) > limit) procs = slice(procs, 0, limit);

	let result = [];
	for (let p in procs) {
		push(result, {
			pid: p.pid,
			name: p.name,
			cpu_ticks: kind == 'cpu' ? p.value : 0,
			rss_bytes: kind == 'ram' ? p.value : 0
		});
	}

	return { processes: result, kind: kind };
}

// --- Service info (uptime, pid) --------------------------------------------
//
// Uptime и pid берём из /proc/<pid>/stat. Формула:
//   process_uptime = boot_time - (start_time / HZ)
// где:
//   boot_time  = первое число из /proc/uptime (в секундах)
//   start_time = 22-е поле /proc/<pid>/stat (в jiffies, индекс 19 после comm)
//   HZ         = 100 (тик ядра OpenWrt)

const HZ = 100;
const PROCESS_NAME_MAP = {
	ubus: 'ubusd',
	rpcd: 'rpcd',
	sysntpd: 'ntpd'
};

function getBootTime() {
	let content = readFileContent('/proc/uptime');
	if (!content) return null;
	let parts = split(content, ' ');
	let uptime = +(parts[0] ?? 0);
	if (uptime != uptime) return null;
	return uptime;
}

function getPid(serviceName) {
	let processName = PROCESS_NAME_MAP[serviceName] ?? serviceName;
	let proc = popen('/bin/pidof ' + processName, 'r');
	if (!proc) return null;

	let output = trim(proc.read('all') ?? '');
	proc.close();

	if (!output) return null;

	let parts = split(output, ' ');
	let pid = +(parts[0] ?? 0);
	if (pid != pid || pid <= 0) return null;

	return pid;
}

function getProcessStartTime(pid) {
	let content = readFileContent('/proc/' + pid + '/stat');
	if (!content) return null;

	let lastParen = rindex(content, ')');
	if (lastParen < 0) return null;

	let tail = substr(content, lastParen + 2);
	let fields = split(tail, ' ');

	if (length(fields) < 20) return null;

	let startTime = +(fields[19] ?? 0);
	if (startTime != startTime) return null;

	return startTime;
}

function getServiceInfo(req) {
	let name = req.args?.name;
	if (!name || type(name) != 'string') {
		return { success: false, error: 'Missing service name' };
	}

	if (match(name, /^[A-Za-z0-9_-]{1,64}$/) == null) {
		return { success: false, error: 'Invalid service name' };
	}

	let pid = getPid(name);
	if (!pid) {
		return {
			success: true,
			name: name,
			pid: null,
			uptime: null,
			running: false
		};
	}

	let bootTime = getBootTime();
	let startTime = getProcessStartTime(pid);

	let uptime = null;
	if (bootTime != null && startTime != null) {
		uptime = bootTime - (startTime / HZ);
		if (uptime < 0) uptime = 0;
	}

	return {
		success: true,
		name: name,
		pid: pid,
		uptime: uptime,
		running: true
	};
}

// --- Service log -----------------------------------------------------------
//
// Используем `logread -l 200 -e <name>` — 200 строк с запасом,
// затем фильтруем по имени процесса в квадратных скобках через regexp().
//
// При include_health_check='1' дополнительно включаем строки, которые пишет
// luci.proton-healthcheck через `logger -t proton-healthcheck "<service>: ..."`.
// Такие строки помечаются префиксом "[HC] ", чтобы UI мог их подсветить.
//
// Формат logread -l <N>:
//   Mon Oct 12 09:36:47 2026 daemon.info dnsmasq[1854]: message
//   Mon Oct 12 09:37:12 2026 user.notice proton-healthcheck: dnsmasq: ...

function getServiceLog(req) {
	let name = req.args?.name;
	let lines = +(req.args?.lines ?? 20);
	let includeHealthCheck = req.args?.include_health_check === '1'
		|| req.args?.include_health_check === 1
		|| req.args?.include_health_check === true;

	if (!name || type(name) != 'string') {
		return { success: false, error: 'Missing service name', lines: [] };
	}
	if (match(name, /^[A-Za-z0-9_-]{1,64}$/) == null) {
		return { success: false, error: 'Invalid service name', lines: [] };
	}
	if (lines < 1 || lines > 200) lines = 20;

	let proc = popen('/sbin/logread -l 200 -e ' + name, 'r');
	if (!proc) {
		return { success: false, error: 'logread unavailable', lines: [] };
	}

	let output = proc.read('all') ?? '';
	proc.close();

	if (!output) return { success: true, lines: [] };

	let serviceRe = regexp(name + "\\[\\d+\\]:");
	let result = [];

	// Первый проход: строки самого сервиса.
	for (let line in split(output, '\n')) {
		let trimmed = trim(line);
		if (!trimmed) continue;
		if (match(trimmed, serviceRe) == null) continue;
		push(result, trimmed);
	}

	// Второй проход: строки health check для этого сервиса.
	if (includeHealthCheck) {
		let hcProc = popen('/sbin/logread -l 200 -e proton-healthcheck', 'r');
		if (hcProc) {
			let hcOutput = hcProc.read('all') ?? '';
			hcProc.close();

			if (hcOutput) {
				// Строки health check имеют вид:
				//   Mon Oct 12 09:36:47 2026 user.notice proton-healthcheck: dnsmasq: ...
				// Фильтруем по "<service>:" после "proton-healthcheck: ".
				let hcPrefix = "proton-healthcheck: " + name + ":";
				for (let line in split(hcOutput, '\n')) {
					let trimmed = trim(line);
					if (!trimmed) continue;
					if (index(trimmed, hcPrefix) < 0) continue;
					push(result, "[HC] " + trimmed);
				}
			}
		}
	}

	let count = length(result);
	if (count > lines) {
		result = slice(result, count - lines);
	}

	return { success: true, lines: result };
}

// --- Network interfaces -----------------------------------------------------
//
// Читаем данные напрямую из /proc и /sys, без ubus.call — чтобы
// избежать проблем с ACL/контекстом rpcd.
//
// Источники:
//   /proc/net/dev                    — счётчики rx/tx байт и пакетов
//   /sys/class/net/<iface>/operstate — состояние up/down
//   /sys/class/net/<iface>/carrier   — наличие линка
//   /sys/class/net/<iface>/type      — тип (1=ethernet, 772=loopback, ...)
//   /etc/config/network              — метаданные UCI (device, proto)

// Хелпер: сортировка массива по up (true вверх), затем по имени.
function sortInterfaces(arr) {
	let n = length(arr);
	for (let i = 0; i < n - 1; i++) {
		let minIdx = i;
		for (let j = i + 1; j < n; j++) {
			let a = arr[minIdx];
			let b = arr[j];
			let aUp = a.up ? 1 : 0;
			let bUp = b.up ? 1 : 0;
			if (bUp > aUp) {
				minIdx = j;
				continue;
			}
			if (bUp == aUp && b.name < a.name) {
				minIdx = j;
			}
		}
		if (minIdx != i) {
			let tmp = arr[i];
			arr[i] = arr[minIdx];
			arr[minIdx] = tmp;
		}
	}
	return arr;
}

// --- Stop reason analysis --------------------------------------------------
//
// Определяет причину остановки сервиса. Двухуровневый каскад:
//
//   Уровень 1: ubus call service list
//     - Если procd хранит exit_code инстанса — точный вердикт:
//         exit_code == 0  → clean-exit (hint=2, серый)
//         exit_code != 0  → crash (hint=3, красный)
//         running: true   → сервис жив, вердикт не нужен
//     - Происходит после clean stop через init.d: procd удаляет инстанс,
//       service list отдаёт {}, каскад идёт дальше.
//
//   Уровень 2: logread -t -l 200
//     - Парсим только строки с unix-timestamp в [ ], окно 60 сек.
//     - Фильтр по имени сервиса (4 формы).
//     - Маркеры в порядке приоритета: crash > clean-exit > restart.
//     - Если matched пуст → истинный silent death (hint=0).
//     - Если matched есть, но маркеров нет → неудачная классификация
//       (hint=3, в деталях — первая значимая строка).
//
// Не полагается на текст в начале строки (Mon Oct 12 ...), только на
// [<unix>.<ms>].

const STOP_ANALYSIS_WINDOW_SEC = 60;
const STOP_ANALYSIS_LOG_LINES = 200;
const STOP_ANALYSIS_MAX_MATCHES = 5;

// Маркеры краха. Регистронезависимо.
const CRASH_MARKERS = [
	'segfault',
	'core dumped',
	'killed by signal',
	'terminated by signal',
	'not stopped on sigterm, sending sigkill',
	'out of memory',
	'oom-killer',
	'fatal error',
	'panic',
	'aborted',
	'failed to start',
	'failed to start up',
	'crash loop',
	'failed to create'
];

// Явные сигналы — ищем отдельно, потому что "signal 11" может быть
// в произвольном тексте.
const CRASH_SIGNAL_PATTERNS = [
	'signal 6',
	'signal 7',
	'signal 11'
];

// Маркеры планового завершения.
const CLEAN_EXIT_MARKERS = [
	'exiting on receipt of sigterm',
	'received sigterm',
	'terminating on signal 15',
	'graceful shutdown'
];

// Маркеры рестарта.
const RESTART_MARKERS = [
	'restarting',
	'restarted'
];

// --- Хелперы --------------------------------------------------------------

// Проверяем, что имя сервиса в строке logread — именно НАШ сервис,
// а не подстрока в чужом имени (catalog/dialog/blog).
//
// Порядок проверок — от точного к общему:
//   1. "<name>["        — busybox/init.d стиль: dnsmasq[1854]:
//   2. "<name>:"        — procd без PID: dnsmasq:
//   3. " <name> "       — procd: "service dnsmasq stopped"
//   4. "<name>.service" — systemd-подобное (на всякий)
function serviceInLine(line, name) {
	if (!line || !name) return false;

	if (index(line, name + '[') >= 0) return true;
	if (index(line, name + ':') >= 0) return true;
	if (index(line, ' ' + name + ' ') >= 0) return true;
	if (index(line, name + '.service') >= 0) return true;

	return false;
}

// Извлекает unix-секунды из "[1791787007.158]".
// Возвращает null, если формат не распознан.
//
// Реальный формат logread -t:
//   Mon Oct 12 09:36:47 2026 [1791787007.158] authpriv.info ...
// Ищем первую '[', затем первую '.' внутри неё.
function parseLogreadTs(line) {
	let open = index(line, '[');
	if (open < 0) return null;

	let tail = substr(line, open + 1);
	let dot = index(tail, '.');
	if (dot < 0) return null;

	let raw = substr(tail, 0, dot);
	let ts = +raw;
	if (ts != ts || ts <= 0) return null;

	return ts;
}

// Ищет первое совпадение маркера в строке (регистронезависимо).
function matchMarker(line, markers, kind) {
	if (!line) return null;
	let lower = lc(line);
	for (let m in markers) {
		if (index(lower, m) >= 0) return { kind: kind, marker: m };
	}
	return null;
}

// Проверяет "exited with code N". Извлекает N.
function matchNonZeroExit(line) {
	if (!line) return null;
	let lower = lc(line);
	let anchor = index(lower, 'exited with code ');
	if (anchor < 0) return null;

	let tail = substr(line, anchor + 17);
	let parts = split(trim(tail), /[ \t;,)]/);
	if (length(parts) < 1) return null;

	let code = +(parts[0]);
	if (code != code) return null;

	if (code != 0) return { kind: 'crash', marker: 'exited with code ' + code };
	return { kind: 'clean-exit', marker: 'exited with code 0' };
}

// Отрезает всё до ']' включительно — получаем читаемый хвост строки
// без timestamp и служебного префикса.
function stripLogreadPrefix(line) {
	let close = index(line, ']');
	if (close < 0) return trim(line);
	return trim(substr(line, close + 1));
}

// --- Классификация по logread ---------------------------------------------

// Определяет вердикт по отфильтрованным строкам (свежие → старые).
// Каждая строка в matched — {ts, line}.
function classifyMatched(matched, service) {
	if (!length(matched)) {
		return {
			type: 'unknown',
			hint: 0,
			details: 'no log lines for ' + service + ' in last ' +
			         STOP_ANALYSIS_WINDOW_SEC + 's',
			matched_lines: []
		};
	}

	for (let i = length(matched) - 1; i >= 0; i--) {
		let entry = matched[i];
		let line = entry.line;

		// 1. Явные сигналы (самое точное)
		let sig = matchMarker(line, CRASH_SIGNAL_PATTERNS, 'crash');
		if (sig) {
			return {
				type: 'crash',
				hint: 3,
				details: 'crashed: ' + sig.marker,
				matched_lines: [line]
			};
		}

		// 2. Краш-маркеры
		let crash = matchMarker(line, CRASH_MARKERS, 'crash');
		if (crash) {
			return {
				type: 'crash',
				hint: 3,
				details: 'crashed: ' + crash.marker,
				matched_lines: [line]
			};
		}

		// 3. Non-zero exit
		let exitInfo = matchNonZeroExit(line);
		if (exitInfo) {
			return {
				type: exitInfo.kind,
				hint: exitInfo.kind == 'crash' ? 3 : 2,
				details: (exitInfo.kind == 'crash' ? 'crashed: ' : 'clean-exit: ') + exitInfo.marker,
				matched_lines: [line]
			};
		}

		// 4. Clean-exit
		let clean = matchMarker(line, CLEAN_EXIT_MARKERS, 'clean-exit');
		if (clean) {
			return {
				type: 'clean-exit',
				hint: 2,
				details: 'clean-exit: ' + clean.marker,
				matched_lines: [line]
			};
		}

		// 5. "service <name> stopped"
		let lower = lc(line);
		if (index(lower, 'service ') >= 0 && index(lower, ' stopped') >= 0) {
			return {
				type: 'clean-exit',
				hint: 2,
				details: 'clean-exit: service stopped',
				matched_lines: [line]
			};
		}

		// 6. Restart
		let restart = matchMarker(line, RESTART_MARKERS, 'restart');
		if (restart) {
			return {
				type: 'restart',
				hint: 1,
				details: 'restarted',
				matched_lines: [line]
			};
		}
	}

	// matched не пуст, но ни один маркер не сработал.
	// Это НЕ silent death — это неудачная классификация. Красный с
	// осмысленным текстом из первой строки.
	let firstLine = matched[0].line;
	return {
		type: 'unknown',
		hint: 3,
		details: 'stopped: ' + stripLogreadPrefix(firstLine),
		matched_lines: [firstLine]
	};
}

// --- Классификация по ubus ------------------------------------------------

// Читает ubus call service list {name}. Возвращает объект или null.
function ubusServiceList(service) {
	// service уже прошёл валидацию [A-Za-z0-9_-]{1,64}.
	let cmd = 'ubus call service list \'{"name":"' + service + '"}\'';
	let proc = popen(cmd, 'r');
	if (!proc) return null;
	let output = proc.read('all');
	proc.close();
	if (!output) return null;
	try { return json(output); } catch (e) { return null; }
}

// Пробует получить вердикт из ubus. Возвращает null, если данных нет.
function analyzeFromUbus(service) {
	let data = ubusServiceList(service);
	if (!data || type(data) != 'object') return null;

	let svc = data[service];
	if (!svc || !svc.instances || type(svc.instances) != 'object')
		return null;

	let bestExitCode = null;
	let bestPid = null;
	let sawRunning = false;

	for (let iname in svc.instances) {
		let inst = svc.instances[iname];
		if (!inst || type(inst) != 'object') continue;

		if (inst.running === true) {
			sawRunning = true;
			// Запоминаем PID живого инстанса.
			if (inst.pid != null) {
				let p = +inst.pid;
				if (p == p && p > 0) bestPid = p;
			}
			continue;
		}

		if (inst.exit_code != null) {
			let code = +inst.exit_code;
			if (code != code) continue;
			bestExitCode = code;
		}
	}

	if (sawRunning) {
		return {
			type: 'running',
			hint: 0,
			pid: bestPid,
			details: 'service is running'
		};
	}

	if (bestExitCode == null) return null;

	if (bestExitCode === 0) {
		return {
			type: 'clean-exit',
			hint: 2,
			pid: null,
			details: 'clean-exit: exited with code 0'
		};
	}

	return {
		type: 'crash',
		hint: 3,
		pid: null,
		details: 'crashed: exited with code ' + bestExitCode
	};
}

// --- Public RPC -----------------------------------------------------------

// analyzeStopReason(service) — двухуровневый каскад: ubus → logread.
// Возвращает вердикт + source, указывающий, откуда он получен.
function analyzeStopReason(req) {
	let name = req.args?.name;
	if (!name || type(name) != 'string') {
		return { success: false, error: 'Missing service name' };
	}
	if (match(name, /^[A-Za-z0-9_-]{1,64}$/) == null) {
		return { success: false, error: 'Invalid service name' };
	}

	// --- Уровень 1: ubus ---------------------------------------------------
	let ubusVerdict = analyzeFromUbus(name);
	if (ubusVerdict) {
		return {
			success: true,
			type: ubusVerdict.type,
			hint: ubusVerdict.hint,
			pid: ubusVerdict.pid,
			details: ubusVerdict.details,
			source: 'ubus',
			matched_lines: [],
			window_sec: STOP_ANALYSIS_WINDOW_SEC
		};
	}

	// --- Уровень 2: logread ------------------------------------------------
	let proc = popen('/sbin/logread -t -l ' + STOP_ANALYSIS_LOG_LINES, 'r');
	if (!proc) {
		return {
			success: false,
			error: 'logread unavailable',
			type: 'unknown',
			hint: 0,
			details: 'logread unavailable',
			source: 'none',
			matched_lines: []
		};
	}

	let output = proc.read('all') ?? '';
	proc.close();

	if (!output) {
		return {
			success: true,
			type: 'unknown',
			hint: 0,
			details: 'logread empty (no lines at all)',
			source: 'logread',
			matched_lines: [],
			window_sec: STOP_ANALYSIS_WINDOW_SEC
		};
	}

	let now = time();
	let matched = [];

	for (let line in split(output, '\n')) {
		if (!line) continue;

		let ts = parseLogreadTs(line);
		if (ts == null) continue;
		if (now - ts > STOP_ANALYSIS_WINDOW_SEC) continue;

		if (!serviceInLine(line, name)) continue;

		push(matched, { ts: ts, line: trim(line) });
	}

	matched = sort(matched, function(a, b) { return b.ts - a.ts; });

	let verdict = classifyMatched(matched, name);

	let lines = verdict.matched_lines ?? [];
	if (length(lines) > STOP_ANALYSIS_MAX_MATCHES)
		lines = slice(lines, 0, STOP_ANALYSIS_MAX_MATCHES);

	return {
		success: true,
		type: verdict.type,
		hint: verdict.hint,
		details: verdict.details,
		source: 'logread',
		matched_lines: lines,
		window_sec: STOP_ANALYSIS_WINDOW_SEC
	};
}

function getNetworkStats() {
	// --- 1. Счётчики из /proc/net/dev ---
	let devContent = readfile('/proc/net/dev');
	if (!devContent) {
		return { interfaces: [], error: '/proc/net/dev unavailable' };
	}

	let counters = {};
	let lines = split(devContent, "\n");

	for (let li = 2; li < length(lines); li++) {
		let line = trim(lines[li]);
		if (length(line) == 0) continue;

		let colon = index(line, ':');
		if (colon < 0) continue;

		let iface = trim(substr(line, 0, colon));
		let rest = trim(substr(line, colon + 1));

		// Поля: rx_bytes rx_packets ... (8 полей) tx_bytes tx_packets ... (8 полей)
		let f = split(rest, /[ \t]+/);
		if (length(f) < 16) continue;

		let rx = +(f[0]);
		if (rx != rx) rx = 0;
		let tx = +(f[8]);
		if (tx != tx) tx = 0;

		counters[iface] = { rx_bytes: rx, tx_bytes: tx };
	}

	// --- 2. Метаданные UCI из /etc/config/network ---
	let metaByDevice = {};
	let uc = cursor();
	uc.load('network');

	uc.foreach('network', 'interface', function(s) {
		let dev = s.device;
		if (!dev) return;

		if (!metaByDevice[dev]) {
			metaByDevice[dev] = {
				interface: s['.name'],
				proto: s.proto || ''
			};
		}
	});

	// --- 3. Финальный список ---
	let interfaces = [];

	for (let name in counters) {
		// Фильтруем loopback
		if (name == 'lo') continue;

		// Фильтруем интерфейсы без присутствия физически.
		// В /sys/class/net/<iface>/ есть файл `ifindex`, если интерфейс существует.
		let operstate = readFileContent('/sys/class/net/' + name + '/operstate');
		let carrier = readFileContent('/sys/class/net/' + name + '/carrier');
		let devType = readFileContent('/sys/class/net/' + name + '/type');

		let meta = metaByDevice[name];
		if (!meta) meta = {};
		let proto = meta.proto;
		if (!proto) proto = '';

		// VPN-интерфейсы (WireGuard/OpenVPN/Tun/Tap) не имеют физлинка:
		// operstate для них часто "unknown"/"down", carrier отсутствует или 0,
		// хотя трафик идёт. Считаем их up, если они есть в /proc/net/dev
		// (counters[name] уже заполнен на этом шаге) и не помечены админом как down.
		let isVpnLike =
			proto == 'wireguard' ||
			index(name, 'wg') == 0 ||
			index(name, 'tun') == 0 ||
			index(name, 'tap') == 0 ||
			index(name, 'ovpn') == 0 ||
			index(name, 'zt') == 0;

		let up;
		let isCarrier;
		if (isVpnLike) {
			// Интерфейс присутствует в /proc/net/dev → он существует и активен.
			// operstate/carrier игнорируем полностью (там мусор).
			up = true;
			isCarrier = true;
		} else {
			up = operstate == 'up';
			isCarrier = carrier == '1';
		}

		// type: 1 = ethernet, 772 = loopback, 65534 = none, 512/... = другие
		let typeStr = 'network';
		let devTypeNum = +(devType);
		if (devTypeNum == 1) typeStr = 'ethernet';
		else if (devTypeNum == 772) typeStr = 'loopback';
		else if (name == 'br-lan' || match(name, /^br-/)) typeStr = 'bridge';


		let ifaceName = meta.interface;
		if (!ifaceName) ifaceName = '';

		// display_name — то, что показываем в карточке. По умолчанию —
		// имя устройства (br-lan, eth0). Alias/interace (lan, wan) идёт
		// отдельно и используется в модальном окне настройки.
		let displayName = name;

		let c = counters[name];

		push(interfaces, {
			name: name,
			display_name: displayName,
			iface: ifaceName,
			proto: proto,
			type: typeStr,
			up: up,
			present: true,
			carrier: isCarrier,
			rx_bytes: c.rx_bytes,
			tx_bytes: c.tx_bytes
		});
	}

	interfaces = sortInterfaces(interfaces);

	return { interfaces: interfaces, timestamp: time() };
}

const methods = {
	getSystemInfo: {
		call: function() {
			return getSystemInfo();
		}
	},
	getServiceInfo: {
		args: { name: 'name' },
		call: function(req) {
			return getServiceInfo(req);
		}
	},
	getServiceLog: {
		args: { name: 'name', lines: 0, include_health_check: '0' },
		call: function(req) {
			return getServiceLog(req);
		}
	},
	analyzeStopReason: {
    args: { name: 'name' },
    call: function(req) {
        return analyzeStopReason(req);
		}
	},
	getProcessCount: {
		call: function() {
			return getProcessCount();
		}
	},
	getTopProcesses: {
		args: { kind: 'kind', limit: 0 },
		call: function(req) {
			let kind = req.args?.kind ?? 'cpu';
			let limit = +(req.args?.limit ?? 3);
			return getTopProcesses(kind, limit);
		}
	},
	getNetworkStats: {
		call: function() {
			return getNetworkStats();
		}
	}
};

return { 'luci.proton-system': methods };

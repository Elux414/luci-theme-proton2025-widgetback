'use strict';

import { readfile, lsdir, popen } from 'fs';
import { cursor } from 'uci';

// --- Package / release helpers (existing) ----------------------------------

function readFileContent(path) {
	let content = readfile(path);
	return content ? trim(content) : null;
}

function parseReleaseValue(content, key) {
	if (!content || !key) return null;

	let pattern = key + "='";
	let start = index(content, pattern);
	if (start < 0) return null;

	let valueStart = start + length(pattern);
	let tail = substr(content, valueStart);
	let valueEnd = index(tail, "'");
	if (valueEnd < 0) return null;

	return substr(tail, 0, valueEnd);
}

function extractUrl(line) {
	if (!line) return null;

	let httpsStart = index(line, 'https://');
	let httpStart = index(line, 'http://');
	let start = httpsStart;

	if (start < 0 || (httpStart >= 0 && httpStart < start))
		start = httpStart;

	if (start < 0) return null;

	let tail = substr(line, start);
	let end = length(tail);

	for (let i = 0; i < length(tail); i++) {
		let ch = substr(tail, i, 1);
		if (ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' || ch == '"' || ch == '\'' || ch == '#') {
			end = i;
			break;
		}
	}

	return substr(tail, 0, end);
}

function isCommentOrEmptyLine(line) {
	let normalized = trim(line || '');
	if (!normalized) return true;

	return index(normalized, '#') == 0;
}

function normalizePackageFeedUrl(url, packageArch) {
	if (!url || !packageArch) return null;

	let marker = '/packages/' + packageArch;
	let markerPos = index(url, marker);
	if (markerPos < 0) return null;

	return substr(url, 0, markerPos + length(marker)) + '/';
}

function findPackageFeedUrlInContent(content, packageArch) {
	if (!content || !packageArch) return null;

	for (let line in split(content, "\n")) {
		if (isCommentOrEmptyLine(line))
			continue;

		let url = extractUrl(line);
		let normalized = normalizePackageFeedUrl(url, packageArch);
		if (normalized) return normalized;
	}

	return null;
}

function buildFallbackPackageFeedUrl(packageArch, releaseVersion) {
	let normalizedRelease = trim(releaseVersion || '');
	if (!normalizedRelease || !packageArch) return null;

	if (normalizedRelease == 'SNAPSHOT' || normalizedRelease == 'snapshot')
		return 'https://downloads.openwrt.org/snapshots/packages/' + packageArch + '/';

	let firstChar = substr(normalizedRelease, 0, 1);
	if (index('0123456789', firstChar) == 0 || index('0123456789', firstChar) > 0)
		return 'https://downloads.openwrt.org/releases/' + normalizedRelease + '/packages/' + packageArch + '/';

	return null;
}

function findPackageFeedUrl(packageArch, releaseVersion) {
	let directFiles = [
		'/etc/opkg/distfeeds.conf',
		'/etc/opkg/customfeeds.conf',
		'/etc/apk/repositories',
		'/etc/apk/distfeeds.list',
		'/etc/apk/repositories.d/distfeeds.list'
	];

	for (let path in directFiles) {
		let content = readFileContent(path);
		let url = findPackageFeedUrlInContent(content, packageArch);
		if (url) return url;
	}

	let repoFiles = lsdir('/etc/apk/repositories.d');
	if (repoFiles) {
		for (let name in repoFiles) {
			let content = readFileContent('/etc/apk/repositories.d/' + name);
			let url = findPackageFeedUrlInContent(content, packageArch);
			if (url) return url;
		}
	}

	return buildFallbackPackageFeedUrl(packageArch, releaseVersion);
}

function getReleaseDescription(release) {
	return parseReleaseValue(release, 'DISTRIB_DESCRIPTION');
}

function getReleaseVersion(release) {
	return parseReleaseValue(release, 'DISTRIB_RELEASE');
}

function getModelFromSysinfo() {
	return readFileContent('/tmp/sysinfo/model');
}

function getTimezoneInfo() {
	let uci = cursor();
	uci.load('system');

	if (!uci.get('system', '@system[0]'))
		return { timezone: '', zonename: '' };

	return {
		timezone: uci.get('system', '@system[0]', 'timezone') ?? '',
		zonename: uci.get('system', '@system[0]', 'zonename') ?? ''
	};
}

function getSystemInfo() {
	let release = readFileContent('/etc/openwrt_release') || '';
	let packageArch = parseReleaseValue(release, 'DISTRIB_ARCH');
	let releaseVersion = getReleaseVersion(release);
	let tz = getTimezoneInfo();

	return {
		package_arch: packageArch,
		target: parseReleaseValue(release, 'DISTRIB_TARGET'),
		release: releaseVersion,
		description: getReleaseDescription(release),
		model: getModelFromSysinfo(),
		package_feed_url: findPackageFeedUrl(packageArch, releaseVersion),
		timezone: tz.timezone,
		zonename: tz.zonename
	};
}

// --- CPU load (existing) ---------------------------------------------------

let prevCpuSnapshot = null;

function readCpuSnapshot() {
	let stat = readfile('/proc/stat');
	if (!stat) return null;

	let firstLine = null;
	for (let line in split(stat, '\n')) {
		if (index(line, 'cpu ') == 0) {
			firstLine = line;
			break;
		}
	}
	if (!firstLine) return null;

	let parts = split(trim(firstLine), /[ \t]+/);
	let values = [];
	let total = 0;

	for (let i = 1; i < length(parts); i++) {
		let v = +parts[i];
		if (v != v) continue;
		push(values, v);
		total += v;
	}

	if (length(values) < 4) return null;

	let idle = (values[3] ?? 0) + (values[4] ?? 0);

	return { total: total, idle: idle };
}

function countCpuCores() {
	let stat = readfile('/proc/stat');
	if (!stat) return 0;

	let cores = 0;
	for (let line in split(stat, '\n')) {
		if (match(line, /^cpu[0-9]+[ \t]/))
			cores++;
	}
	return cores;
}

function getCpuUsage() {
	let snapshot = readCpuSnapshot();

	if (!snapshot) {
		return { usage: null, cores: countCpuCores() };
	}

	let cores = countCpuCores();

	if (prevCpuSnapshot == null) {
		prevCpuSnapshot = snapshot;
		return { usage: null, cores: cores };
	}

	let dTotal = snapshot.total - prevCpuSnapshot.total;
	let dIdle = snapshot.idle - prevCpuSnapshot.idle;

	prevCpuSnapshot = snapshot;

	if (dTotal <= 0) {
		return { usage: 0, cores: cores };
	}

	let usage = ((dTotal - dIdle) / dTotal) * 100;

	if (usage < 0) usage = 0;
	if (usage > 100) usage = 100;

	return { usage: int(usage * 10) / 10, cores: cores };
}

// --- Service info (uptime, pid) --------------------------------------------
//
// Uptime и pid берём из /proc/<pid>/stat. Формула:
//   process_uptime = boot_time - (start_time / HZ)
// где:
//   boot_time  = первое число из /proc/uptime (в секундах)
//   start_time = 22-е поле /proc/<pid>/stat (в jiffies, индекс 19 после comm)
//   HZ         = 100 (тик ядра OpenWrt)

const HZ = 100;
const PROCESS_NAME_MAP = {
	ubus: 'ubusd',
	rpcd: 'rpcd',
	sysntpd: 'ntpd'
};

function getBootTime() {
	let content = readFileContent('/proc/uptime');
	if (!content) return null;
	let parts = split(content, ' ');
	let uptime = +(parts[0] ?? 0);
	if (uptime != uptime) return null;
	return uptime;
}

function getPid(serviceName) {
	let processName = PROCESS_NAME_MAP[serviceName] ?? serviceName;
	let proc = popen('/bin/pidof ' + processName, 'r');
	if (!proc) return null;

	let output = trim(proc.read('all') ?? '');
	proc.close();

	if (!output) return null;

	let parts = split(output, ' ');
	let pid = +(parts[0] ?? 0);
	if (pid != pid || pid <= 0) return null;

	return pid;
}

function getProcessStartTime(pid) {
	let content = readFileContent('/proc/' + pid + '/stat');
	if (!content) return null;

	let lastParen = rindex(content, ')');
	if (lastParen < 0) return null;

	let tail = substr(content, lastParen + 2);
	let fields = split(tail, ' ');

	if (length(fields) < 20) return null;

	let startTime = +(fields[19] ?? 0);
	if (startTime != startTime) return null;

	return startTime;
}

function getServiceInfo(req) {
	let name = req.args?.name;
	if (!name || type(name) != 'string') {
		return { success: false, error: 'Missing service name' };
	}

	if (match(name, /^[A-Za-z0-9_-]{1,64}$/) == null) {
		return { success: false, error: 'Invalid service name' };
	}

	let pid = getPid(name);
	if (!pid) {
		return {
			success: true,
			name: name,
			pid: null,
			uptime: null,
			running: false
		};
	}

	let bootTime = getBootTime();
	let startTime = getProcessStartTime(pid);

	let uptime = null;
	if (bootTime != null && startTime != null) {
		uptime = bootTime - (startTime / HZ);
		if (uptime < 0) uptime = 0;
	}

	return {
		success: true,
		name: name,
		pid: pid,
		uptime: uptime,
		running: true
	};
}

// --- Service log -----------------------------------------------------------
//
// Используем `logread -l 200 -e <name>` — 200 строк с запасом,
// затем фильтруем по имени процесса в квадратных скобках через regexp().

function getServiceLog(req) {
	let name = req.args?.name;
	let lines = +(req.args?.lines ?? 20);

	if (!name || type(name) != 'string') {
		return { success: false, error: 'Missing service name', lines: [] };
	}
	if (match(name, /^[A-Za-z0-9_-]{1,64}$/) == null) {
		return { success: false, error: 'Invalid service name', lines: [] };
	}
	if (lines < 1 || lines > 200) lines = 20;

	let proc = popen('/sbin/logread -l 200 -e ' + name, 'r');
	if (!proc) {
		return { success: false, error: 'logread unavailable', lines: [] };
	}

	let output = proc.read('all') ?? '';
	proc.close();

	if (!output) return { success: true, lines: [] };

	let pattern = name + "\\[\\d+\\]:";
	let re = regexp(pattern);
	let result = [];

	for (let line in split(output, '\n')) {
		let trimmed = trim(line);
		if (!trimmed) continue;
		if (match(trimmed, re) == null) continue;
		push(result, trimmed);
	}

	let count = length(result);
	if (count > lines) {
		result = slice(result, count - lines);
	}

	return { success: true, lines: result };
}

const methods = {
	getSystemInfo: {
		call: function() {
			return getSystemInfo();
		}
	},
	getCpuUsage: {
		call: function() {
			return getCpuUsage();
		}
	},
	getServiceInfo: {
		args: { name: 'name' },
		call: function(req) {
			return getServiceInfo(req);
		}
	},
	getServiceLog: {
		args: { name: 'name', lines: 0 },
		call: function(req) {
			return getServiceLog(req);
		}
	}
};

return { 'luci.proton-system': methods };

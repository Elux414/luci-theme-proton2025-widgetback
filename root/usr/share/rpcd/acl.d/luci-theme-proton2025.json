{
    "luci-theme-proton2025": {
        "description": "Proton2025 theme - temperature sensor, setting access, and services monitoring",
        "read": {
            "ubus": {
                "luci.proton-temp": [
                    "getSensors",
                    "getThresholds",
                    "resetPeaks"
                ],
                "luci.proton-system": [
                    "getSystemInfo",
                    "getCpuUsage"
                ],
                "luci.proton-search-cache": [
                    "loadCache"
                ],
                "luci.proton-settings": [
                    "getSettings",
                    "getVersion",
                    "checkUpdate"
                ],
                "system": [
                    "board",
                    "info"
                ],
                "network.interface": [
                    "dump"
                ],
                "network.device": [
                    "status"
                ],
                "luci-rpc": [
                    "getDHCPLeases"
                ],
                "rc": [
                    "list"
                ]
            },
            "uci": [
                "proton2025",
                "network",
                "wireless",
                "dhcp"
            ],
            "file": {
                "/etc/init.d/*": [
                    "exec"
                ],
                "/bin/pidof": [
                    "exec"
                ],
                "/proc/cpuinfo": [
                    "read"
                ],
                "/proc/stat": [
                    "read"
                ],
                "/tmp/sysinfo/model": [
                    "read"
                ]
            }
        },
        "write": {
            "ubus": {
                "luci.proton-temp": [
                    "setThresholds"
                ],
                "luci.proton-settings": [
                    "setSetting",
                    "setSettings",
                    "resetSettings",
                    "installUpdate"
                ],
                "luci.proton-search-cache": [
                    "saveCache",
                    "clearCache"
                ],
                "rc": [
                    "init"
                ]
            },
            "uci": [
                "proton2025"
            ]
        }
    }
}

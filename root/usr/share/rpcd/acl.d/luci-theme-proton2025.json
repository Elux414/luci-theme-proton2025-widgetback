{
    "luci-theme-proton2025": {
        "description": "Proton2025 theme - temperature sensor, setting access, and services monitoring",
        "read": {
            "ubus": {
                "luci.proton-temp": [
                    "getSensors",
                    "getThresholds",
                    "resetPeaks"
                ],
                "luci.proton-system": [
					"getSystemInfo",
					"getCpuUsage",
					"getServiceInfo",
					"getServiceLog",
					"getProcessCount",
					"getTopProcesses",
					"getNetworkStats",
					"analyzeStopReason"
				],
                "luci.proton-search-cache": [
                    "loadCache"
                ],
                "luci.proton-settings": [
                    "getSettings",
                    "getVersion",
                    "checkUpdate"
                ],
				"luci.proton-healthcheck": [
					"getMethods",
					"getConfig",
					"runCheck"
				],
                "system": [
                    "board",
                    "info"
                ],
                "network.interface": [
                    "dump"
                ],
                "network.device": [
                    "status"
                ],
                "rc": [
                    "list"
                ],
				"luci.proton-nlbw": [
					"getHostTraffic",
					"isAvailable",
					"debug"
				],
				"luci-rpc": [
					"getDHCPLeases",
					"getHostHints"
				],
				"iwinfo": [
					"devices",
					"assoclist"
				],
				"luci.proton-services-history": [
                    "readHistory",
                    "readHealthHistory",
                    "readUserActions",
                    "getStorageStats"
                ],
				"luci.proton-services-events": [
					"readEvents",
					"getStorageStats"
				]
            },
            "uci": [
                "proton2025",
                "network",
                "wireless",
                "dhcp",
				"system"
            ],
            "file": {
                "/etc/init.d/*": [
                    "exec"
                ],
                "/bin/pidof": [
                    "exec"
                ],
                "/proc/cpuinfo": [
                    "read"
                ],
                "/proc/stat": [
                    "read"
                ],
                "/tmp/sysinfo/model": [
                    "read"
                ]
            }
        },
        "write": {
            "ubus": {
                "luci.proton-temp": [
                    "setThresholds"
                ],
                "luci.proton-settings": [
                    "setSetting",
                    "setSettings",
                    "resetSettings",
                    "installUpdate"
                ],
                "luci.proton-search-cache": [
                    "saveCache",
                    "clearCache"
                ],
				"luci.proton-healthcheck": [
					"setGlobal",
					"setService",
					"clearService"
				],
                "rc": [
                    "init"
                ],
                "luci.proton-services-history": [
                    "writeHistory",
                    "writeHealthHistory",
                    "writeUserAction",
                    "clearHistory",
                    "clearAll"
                ],
				"luci.proton-services-events": [
					"appendEvent",
					"clearEvents"
				]
            },
            "uci": [
                "proton2025"
            ]
        }
    }
}
